# Copia este archivo como "secrets.env" (en esta misma carpeta) y rellena lo que uses.
# secrets.env NUNCA se comparte ni se sube a GitHub.

# Hugging Face (GRATIS): mas cuota de GPU en los Spaces y creditos de Inference.
# Crea un token "Read" en https://huggingface.co/settings/tokens
HF_TOKEN=

# Cerebro / director de estilo (https://console.anthropic.com)
ANTHROPIC_API_KEY=

# Imagen GRATIS (plan free, sin tarjeta): https://enter.pollinations.ai
POLLINATIONS_API_KEY=

# Imagen, musica, SFX y 3D en la nube (https://replicate.com/account/api-tokens)
REPLICATE_API_TOKEN=

# Subida a Roblox Open Cloud (https://create.roblox.com/dashboard/credentials)
# Permiso necesario: "assets" -> read + write
ROBLOX_API_KEY=
